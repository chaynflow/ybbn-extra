# 本地开发：把 TURSO_DATABASE_URL 留空、DB_MODE 设为 local，就会用 file:local.db
# 部署到 Render 时，在 Environment 里配置下面这些真实值（DB_MODE 不要设）

# Turso 数据库地址，形如：
#   libsql://ybbn-extra-你的用户名.turso.io
TURSO_DATABASE_URL=

# Turso 数据库令牌（与上面地址配对的 token）
#   生成方式：turso db tokens create ybbn-extra
#   （只读副本用 turso db tokens create ybbn-extra --read-only）
TURSO_AUTH_TOKEN=

# 本地开发模式（可选）：
#   DB_MODE=local  →  连 file:local.db，无需 Turso
# DB_MODE=local

# 渲染平台会自动注入 PORT，本地默认 3000
PORT=3000

# 部署在 HTTPS（Render 默认就是）时设 1，让会话 Cookie 带 Secure
COOKIE_SECURE=1

# 生产环境请设成 production
NODE_ENV=production
